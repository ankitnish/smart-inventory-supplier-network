# Copy to .env and replace every placeholder. Never commit .env.
POSTGRES_USER=sisn
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=sisn
DATABASE_URL=postgresql://sisn:change-me-db-password@localhost:5432/sisn
JWT_SECRET=replace-with-a-random-string-of-at-least-32-characters
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:3000
ML_SERVICE_URL=http://localhost:8000
REDIS_URL=redis://localhost:6379
# Seed-only (demo accounts). Admin accounts are created by seed/CLI, never by public registration.
DEMO_PASSWORD=change-me-demo-pass1
ADMIN_EMAIL=admin@example.test
ADMIN_PASSWORD=change-me-admin-password
NEXT_PUBLIC_API_URL=http://localhost:4000/api
